NODE_ENV=development
PORT=3000
# Localmente, o painel administrativo usa esta porta. No Cloud Run ele é outro serviço.
ADMIN_PORT=3001
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-seguro

# Backend: chave secreta da API, nunca publicar no frontend.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=SEU_PROJECT_REF
SUPABASE_API=

# CLI: token pessoal e senha PostgreSQL (diferentes da chave da API).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Meta WhatsApp Cloud API: variáveis exclusivas do backend.
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Segredo do app Meta usado para validar x-hub-signature-256 no webhook.
META_APP_SECRET=

# Destinos corporativos das notificações de novas triagens. Use somente dígitos,
# com DDI e DDD. Os valores abaixo foram extraídos da lista de contatos da Life.
COMMERCIAL_NOTIFICATION_PHONE_E164=5579999250532
TECHNICAL_NOTIFICATION_PHONE_E164=5579998901667
# Os e-mails finais seguem as assinaturas: Vendas e Contato (rota técnica).
COMMERCIAL_NOTIFICATION_EMAIL=vendas@life.eng.br
TECHNICAL_NOTIFICATION_EMAIL=contato@life.eng.br
# Comece em modo test: os dois fluxos enviam apenas para informática.
# Mude para department depois de homologar para enviar aos e-mails dos setores.
OPERATIONAL_NOTIFICATION_EMAIL_MODE=test
OPERATIONAL_NOTIFICATION_TEST_EMAIL=informatica@life.eng.br

# Ploomes CRM: User-Key de um usuário de integração, usada apenas pelo backend.
PLOOMES_USER_KEY=

# OpenAI: classificação complementar de mensagens ambíguas. Nunca use no frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Único número autorizado a alterar a operação pelo WhatsApp.
ADMIN_PHONE_E164=

# Chave de acesso da dashboard /admin (mínimo 24 caracteres). Guarde no Secret Manager.
ADMIN_DASHBOARD_TOKEN=

# Proteção complementar do Cloud Run por IAP. Habilite somente atrás do IAP e
# informe e-mails corporativos já cadastrados no painel como admin ou coordenação.
IAP_REQUIRED=false
IAP_ALLOWED_EMAILS=

# Senha da caixa postal usada para disparar e-mails. Configure-a no Secret
# Manager em produção; ela nunca deve ser salva no painel administrativo.
SMTP_PASSWORD=

# Destinatários corporativos, separados por vírgula, para alertas operacionais.
ALERT_NOTIFICATION_EMAILS=
